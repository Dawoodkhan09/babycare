# Local development env vars (copy to .env and edit)
SECRET_KEY=your-secret-key-here-make-it-long-and-random
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# PostgreSQL (recommended): postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgres://babycare_user:your_password@localhost:5432/babycare_db
# SQLite fallback (DATABASE_URL hata dein to bhi yehi use hota hai):
# DATABASE_URL=sqlite:///db.sqlite3
CORS_ALLOWED_ORIGINS=http://localhost:3000
GEMINI_API_KEY=your-gemini-api-key
