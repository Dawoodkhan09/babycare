    "q_redflags": {
      "type": "multi_select",
      "text": {
        "en": "Important: does your baby have any of these danger signs?",
        "ur": "اہم: کیا بچے میں ان میں سے کوئی خطرے کی علامت ہے؟",
        "roman": "Zaroori: kya bachay mein in mein se koi khatre ki alamat hai?"
      },
      "options": [
        { "id": "breathing", "label": { "en": "Difficulty breathing", "ur": "سانس لینے میں دقت", "roman": "Saans lene mein mushkil" }, "set": { "emergency": true } },
        { "id": "unconscious", "label": { "en": "Unconscious / very hard to wake", "ur": "بے ہوشی / مشکل سے جاگنا", "roman": "Behoshi / mushkil se jaagna" }, "set": { "emergency": true } },
        { "id": "blue_lips", "label": { "en": "Blue lips or face", "ur": "نیلے ہونٹ یا چہرہ", "roman": "Neelay hont ya chehra" }, "set": { "emergency": true } },
        { "id": "seizure", "label": { "en": "Seizure / fits", "ur": "دورہ / جھٹکے", "roman": "Daura / jhatke" }, "set": { "emergency": true } },
        { "id": "no_urine", "label": { "en": "No urine for 8+ hours", "ur": "8 گھنٹے سے پیشاب نہیں", "roman": "8 ghante se peshab nahi" }, "set": { "emergency": true } },
        { "id": "none", "exclusive": true, "label": { "en": "None of these", "ur": "ان میں سے کوئی نہیں", "roman": "In mein se koi nahi" }, "set": {} }
